PORT=3000
HOST=0.0.0.0

# sqld user port (SQL) and admin port (namespaces)
SQLD_URL=http://sqld:8080
SQLD_ADMIN_URL=http://sqld:8081

# Suffix appended to the namespace for the Host header: <ns>.<SQLD_HOST_SUFFIX>
SQLD_HOST_SUFFIX=local

# sqld auth. Run `npm run auth:generate` after copying this file to create
# secrets/sqld-jwt-public.pem and fill in both values.
# SQLD_AUTH_TOKEN is a Bearer JWT for the sqld user API.
# SQLD_ADMIN_TOKEN is the shared Basic key for the sqld admin API.
SQLD_AUTH_TOKEN=
SQLD_ADMIN_TOKEN=

# Host path to the Ed25519 private key used by the token UI.
SQLD_JWT_PRIVATE_KEY_FILE=./secrets/sqld-jwt-private.pem
# UID/GID for the Compose app container so it can read the 0600 key.
# npm run auth:generate fills these in.
APP_UID=1000
APP_GID=1000

# App login (HTTP Basic). Required unless ALLOW_NO_AUTH=true (local dev only)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ALLOW_NO_AUTH=false
